DATABASE_URL=postgresql+asyncpg://wmt:wmt@localhost:5432/worthmytime
# min. 32 znaki (wymagane przy DEBUG=false)
JWT_SECRET=change-me-change-me-change-me-change-me
# konkretne domeny frontendu (cookie sesji wymaga konkretnej domeny, nie *)
CORS_ORIGINS=http://localhost:3000
# sesja w cookie: lax (ta sama strona), none (frontend i API na różnych domenach; wymaga HTTPS)
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true (domyślnie włączone poza DEBUG)
# COOKIE_DOMAIN=.twoja-domena.pl
PORT=8001
LOG_LEVEL=INFO
# limity żądań (okno przesuwne, w pamięci procesu)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_MINUTE=20
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
# TRUST_PROXY=true tylko za zaufanym reverse proxy
TRUST_PROXY=false
# Jev (TypeSafe AI): klucz tylko tutaj, w backendzie; pusty = podpowiedzi wyłączone
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai   (albo proxy LiteLLM: http://litellm:4000/typesafe)
# TYPESAFE_MODEL=jev-latest
RATE_LIMIT_AI_PER_MINUTE=20
# Asystent AI: model przez API zgodne z OpenAI; pusty klucz albo model = asystent wyłączony
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
# ASSISTANT_BASE_URL=https://api.openai.com/v1   (albo proxy LiteLLM: http://litellm:4000/v1)
# przełączniki funkcji, np. reports,tags=false (GET /api/v1/features)
FEATURE_FLAGS=
DEBUG=true
